// renovate.json5 - Mender dependency update configuration for mender-cli
// See Documentation/dependency-updates.md in mender-qa for the process.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":gitSignOff"
  ],

  // CODEOWNERS assigns backend for everything here.
  "reviewersFromCodeOwners": true,

  // chore(deps): <desc>, per renovate.json5.sample in mender-qa.
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",

  // Only rebase open PRs when they actually conflict. Rebasing every time the
  // base branch moves restarts a pipeline for every open PR on each merge.
  "rebaseWhen": "conflicted",

  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,

  // Only master. 1.9.x through 1.12.x are still on the remote but all have been
  // dormant since 2023 at the latest, and Dependabot never targeted them either.
  "baseBranchPatterns": ["master"],

  // Security PRs bypass the schedule and automerge when CI is green.
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": true,
    "automergeType": "pr",
    "labels": ["security"]
  },

  // DOCKER_VERSION is a plain .gitlab-ci.yml variable here, not a value: block.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.gitlab-ci.yml/"],
      "matchStrings": [
        "DOCKER_VERSION:\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "docker",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  "packageRules": [

    // CI file updates get ci: instead of fix(deps):
    {
      "matchManagers": ["gitlabci", "gitlabci-include"],
      "semanticCommitType": "ci",
      "semanticCommitScope": ""
    },

    // Go: one PR for all modules, matching Dependabot's golang-dependencies group.
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "groupName": "golang-dependencies",
      "groupSlug": "golang-dependencies",
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Container images (development)",
      "groupSlug": "container-images-dev",
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile"],
      "groupName": "Container images",
      "groupSlug": "container-images",
      "semanticCommitType": "fix"
    },

    // Renovate disables git-submodules by default, but Dependabot was updating
    // tests/mender_server monthly, so keep that going.
    {
      "matchManagers": ["git-submodules"],
      "enabled": true
    }
  ]
}
